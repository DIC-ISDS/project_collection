---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
  id?: string;
}
const { eyebrow, title, description, align = 'left', as: Tag = 'h2', id } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag
    id={id}
    class:list={[
      'font-semibold tracking-tight text-balance text-ink',
      eyebrow && 'mt-3',
      Tag === 'h1' ? 'text-4xl leading-[1.1] sm:text-5xl' : 'text-3xl leading-tight sm:text-[2.25rem]',
    ]}
  >
    {title}
  </Tag>
  {description && <p class="mt-4 text-lg leading-relaxed text-pretty text-muted">{description}</p>}
  <slot />
</div>
