---
import type { StatusTone } from '../data/projects';

interface Props {
  tone: StatusTone;
  label: string;
  dark?: boolean;
}
const { tone, label, dark = false } = Astro.props;

const light: Record<StatusTone, string> = {
  live: 'bg-emerald-50 text-emerald-800 ring-emerald-200',
  ready: 'bg-blue-50 text-blue-800 ring-blue-200',
  pilot: 'bg-amber-50 text-amber-900 ring-amber-200',
  planned: 'bg-slate-50 text-slate-700 ring-slate-200',
};
const darkTones: Record<StatusTone, string> = {
  live: 'bg-emerald-400/10 text-emerald-300 ring-emerald-400/25',
  ready: 'bg-blue-400/10 text-blue-200 ring-blue-400/25',
  pilot: 'bg-amber-400/10 text-amber-200 ring-amber-400/25',
  planned: 'bg-white/5 text-slate-300 ring-white/15',
};
const dot: Record<StatusTone, string> = {
  live: 'bg-emerald-500',
  ready: 'bg-blue-500',
  pilot: 'bg-amber-500',
  planned: 'bg-slate-400',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium whitespace-nowrap ring-1 ring-inset',
    dark ? darkTones[tone] : light[tone],
  ]}
>
  <span class:list={['size-1.5 rounded-full', dot[tone]]} aria-hidden="true"></span>
  {label}
</span>
