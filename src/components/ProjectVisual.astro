---
/**
 * A CSS composition that previews a project's documented workflow.
 * It stands in for screenshots, which have not been supplied. It is
 * decorative: the same steps appear as text on the project page.
 */
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  size?: 'card' | 'hero';
  /** Card shown beside its text on large screens */
  wide?: boolean;
}
const { project, size = 'card', wide = false } = Astro.props;
const steps = project.approach.steps.slice(0, size === 'card' && !wide ? 4 : 6);
const IconComponent = project.icon;
---

<div
  class:list={[
    'grid-backdrop-dark relative overflow-hidden bg-navy',
    size === 'card' ? 'rounded-t-xl px-5 pt-5 pb-6' : 'rounded-2xl p-6 sm:p-8',
    wide && 'lg:flex lg:w-[48%] lg:shrink-0 lg:flex-col lg:justify-center lg:rounded-tr-none lg:rounded-l-xl lg:p-8',
  ]}
  aria-hidden="true"
>
  <div class="pointer-events-none absolute -top-24 -right-16 size-64 rounded-full bg-blue-500/15 blur-3xl"></div>

  <div class="relative flex items-center gap-3">
    <span class="inline-flex size-9 items-center justify-center rounded-lg bg-white/10 text-white ring-1 ring-white/15">
      <IconComponent class="size-[18px]" stroke-width={1.75} />
    </span>
    <span class="text-sm font-semibold tracking-wide text-white">{project.shortName}</span>
    <span class="ml-auto truncate text-xs text-slate-400">{project.approach.title}</span>
  </div>

  <ol class:list={['relative mt-5 grid gap-2', size === 'card' ? 'grid-cols-2' : 'grid-cols-2 sm:grid-cols-3']}>
    {
      steps.map((step, i) => (
        <li class="flex items-center gap-2 rounded-lg bg-white/[0.06] px-3 py-2.5 ring-1 ring-white/10">
          <span class:list={[
            'inline-flex size-5 shrink-0 items-center justify-center rounded-full text-[10px] font-semibold',
            i === 0 ? 'bg-blue-500 text-white' : 'bg-white/10 text-slate-300'
          ]}>
            {i + 1}
          </span>
          <span class="truncate text-xs font-medium text-slate-200">{step.title}</span>
        </li>
      ))
    }
  </ol>
</div>
