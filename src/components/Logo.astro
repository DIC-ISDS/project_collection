---
import { site } from '../data/site';

interface Props {
  inverted?: boolean;
}
const { inverted = false } = Astro.props;
---

<span class="flex items-center gap-2.5">
  <svg viewBox="0 0 32 32" class="size-8 shrink-0" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill={inverted ? '#ffffff' : '#0b1b34'}></rect>
    <path
      d="M9 10.5h14M9 16h14M9 21.5h9"
      stroke={inverted ? '#0b1b34' : '#ffffff'}
      stroke-width="2.6"
      stroke-linecap="round"></path>
    <circle cx="22.5" cy="21.5" r="2.2" fill="#3b82f6"></circle>
  </svg>
  <span class="flex flex-col leading-none">
    <span class:list={['text-[15px] font-semibold tracking-tight', inverted ? 'text-white' : 'text-ink']}>
      {site.shortName}
    </span>
    <span class:list={['mt-1 text-[11px] font-medium', inverted ? 'text-slate-400' : 'text-muted']}>
      {site.departmentShort} · {site.institutionShort}
    </span>
  </span>
</span>
