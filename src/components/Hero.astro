---
import { url } from '../lib/url';
import { ArrowRight } from '@lucide/astro';
import Button from './Button.astro';
import { site } from '../data/site';
import { projects, type StatusTone } from '../data/projects';

const MAX_TILES = 6;
const overflow = projects.length > MAX_TILES;
// Leave the last slot for the "+N more" tile when there are too many to show.
const shown = overflow ? projects.slice(0, MAX_TILES - 1) : projects;
const hidden = projects.length - shown.length;

const dot: Record<StatusTone, string> = {
  live: 'bg-emerald-500',
  ready: 'bg-blue-500',
  pilot: 'bg-amber-500',
  planned: 'bg-slate-400',
};
// Only list the statuses that appear in the panel.
const legendLabels: Record<StatusTone, string> = {
  live: 'In use',
  ready: 'Rolling out',
  pilot: 'Pilot or prototype',
  planned: 'Planned',
};
const legend = (Object.keys(legendLabels) as StatusTone[])
  .filter((tone) => shown.some((p) => p.status.tone === tone))
  .map((tone) => ({ tone, label: legendLabels[tone] }));
---

<section class="relative overflow-hidden border-b border-line bg-subtle" aria-labelledby="hero-title">
  <div class="grid-backdrop pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_top_left,black_30%,transparent_75%)]"></div>

  <div class="container-page relative grid items-center gap-14 py-16 sm:py-24 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-3 py-1 text-xs font-medium text-slate-600">
        <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        {site.department}, {site.institutionShort}
      </p>
      <h1 id="hero-title" class="mt-6 text-4xl leading-[1.08] font-semibold tracking-tight text-balance text-ink sm:text-5xl lg:text-[3.4rem]">
        Building smarter systems for a more connected university.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-pretty text-muted">
        {site.description}
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <Button href={url('/projects')}>
          Explore our projects
          <ArrowRight class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
        </Button>
        <Button href={url('/contact')} variant="secondary">Start a conversation</Button>
      </div>
    </div>

    <!--
      Compact overview of the systems ISDS builds. Shows at most MAX_TILES;
      beyond that, the last tile links to the full projects page so the hero
      keeps the same height as the portfolio grows.
    -->
    <div class="relative">
      <div class="rounded-2xl border border-line bg-white p-2 shadow-xl shadow-slate-200/60">
        <div class="flex items-center justify-between px-4 pt-3 pb-3">
          <p class="text-sm font-semibold text-ink">Systems we build</p>
          <a href={url('/projects')} class="text-xs font-medium text-accent hover:text-accent-strong">
            View all {projects.length}
          </a>
        </div>
        <ul class="grid grid-cols-2 gap-2">
          {
            shown.map((p) => {
              const Icon = p.icon;
              return (
                <li>
                  <a
                    href={url(`/projects/${p.slug}`)}
                    class="flex h-full items-center gap-3 rounded-xl border border-line p-3 transition-colors hover:border-slate-300 hover:bg-subtle"
                  >
                    <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg bg-navy text-white">
                      <Icon class="size-[18px]" stroke-width={1.75} aria-hidden="true" />
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="flex items-center gap-1.5">
                        <span class="truncate text-sm font-semibold text-ink">{p.shortName}</span>
                        <span class:list={['size-1.5 shrink-0 rounded-full', dot[p.status.tone]]} title={p.status.label} aria-hidden="true" />
                        <span class="sr-only">({p.status.label})</span>
                      </span>
                      <span class="block truncate text-xs text-muted">{p.domain}</span>
                    </span>
                  </a>
                </li>
              );
            })
          }
          {
            hidden > 0 && (
              <li>
                <a
                  href={url('/projects')}
                  class="flex h-full items-center justify-center gap-1.5 rounded-xl border border-dashed border-line p-3 text-sm font-medium text-muted transition-colors hover:border-slate-300 hover:text-ink"
                >
                  +{hidden} more
                  <ArrowRight class="size-4" aria-hidden="true" />
                </a>
              </li>
            )
          }
        </ul>
        <ul class="flex flex-wrap gap-x-4 gap-y-1 px-4 pt-3 pb-2 text-xs text-muted" aria-label="Status key">
          {
            legend.map((l) => (
              <li class="flex items-center gap-1.5">
                <span class:list={['size-1.5 rounded-full', dot[l.tone]]} aria-hidden="true" />
                {l.label}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
