---
import { url } from '../lib/url';
import { ArrowRight, Mail } from '@lucide/astro';
import Button from './Button.astro';
import { mailto, site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Have a process that still runs on paper?',
  description = 'We work with UPLB offices to turn manual workflows into reliable systems. Tell us what you need, and we will start with how your office works today.',
} = Astro.props;
---

<section class="py-20 sm:py-24" aria-labelledby="cta-title">
  <div class="container-page">
    <div class="grid-backdrop-dark relative overflow-hidden rounded-2xl bg-navy px-6 py-14 sm:px-12 sm:py-16">
      <div class="pointer-events-none absolute -bottom-32 -left-20 size-80 rounded-full bg-blue-500/20 blur-3xl" aria-hidden="true"></div>
      <div class="relative flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-2xl">
          <h2 id="cta-title" class="text-3xl font-semibold tracking-tight text-balance text-white sm:text-4xl">{title}</h2>
          <p class="mt-4 text-lg leading-relaxed text-slate-300">{description}</p>
        </div>
        <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
          <Button href={mailto()} variant="light">
            <Mail class="size-4" aria-hidden="true" />
            Email {site.shortName}
          </Button>
          <Button href={url('/contact')} variant="glass">
            Contact details
            <ArrowRight class="size-4" aria-hidden="true" />
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
