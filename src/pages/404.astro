---
import { url } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist.">
  <section class="grid-backdrop">
    <div class="container-page flex min-h-[60vh] flex-col items-start justify-center py-24">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">This page doesn’t exist</h1>
      <p class="mt-4 max-w-lg text-lg text-muted">The link may be outdated, or the page may have moved.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href={url('/')}>Back to home</Button>
        <Button href={url('/projects')} variant="secondary">View projects</Button>
      </div>
    </div>
  </section>
</BaseLayout>
