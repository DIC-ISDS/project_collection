---
import { url } from '../lib/url';
import { Compass, Target, BuildingComplex } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CallToAction from '../components/CallToAction.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { projects } from '../data/projects';

const partners = projects.map((p) => ({ name: p.partner, project: p.shortName, slug: p.slug }));
---

<BaseLayout
  title="About"
  description="ISDS is a unit of the Digital Innovation Center at UPLB that designs, develops and maintains information systems and databases for university operations."
>
  <section class="border-b border-line bg-subtle">
    <div class="grid-backdrop">
      <div class="container-page py-16 sm:py-24">
        <SectionHeading as="h1" eyebrow="About ISDS" title="We build the systems that keep university operations running" description={site.about[0]} />
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-24" aria-labelledby="who-title">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
      <div>
        <h2 id="who-title" class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Who we are</h2>
        <dl class="mt-8 space-y-5 text-sm">
          <div class="flex gap-4">
            <dt class="w-28 shrink-0 font-medium text-muted">Section</dt>
            <dd class="text-ink">{site.name} ({site.shortName})</dd>
          </div>
          <div class="flex gap-4">
            <dt class="w-28 shrink-0 font-medium text-muted">Department</dt>
            <dd class="text-ink">{site.department} ({site.departmentShort})</dd>
          </div>
          <div class="flex gap-4">
            <dt class="w-28 shrink-0 font-medium text-muted">Institution</dt>
            <dd class="text-ink">{site.institution} ({site.institutionShort})</dd>
          </div>
        </dl>
      </div>
      <div class="space-y-5 text-lg leading-relaxed text-slate-700">
        {site.about.slice(1).map((p) => <p>{p}</p>)}
        <p>{site.approach}</p>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-subtle py-20 sm:py-24" aria-label="Mission and vision">
    <div class="container-page grid gap-6 md:grid-cols-2">
      <article class="rounded-2xl border border-line bg-white p-8">
        <span class="inline-flex size-10 items-center justify-center rounded-lg bg-accent-soft text-accent">
          <Target class="size-5" aria-hidden="true" stroke-width={1.75} />
        </span>
        <h2 class="mt-6 text-xl font-semibold text-ink">Our mission</h2>
        <p class="mt-3 text-lg leading-relaxed text-slate-700">{site.mission}</p>
      </article>
      <article class="rounded-2xl border border-line bg-white p-8">
        <span class="inline-flex size-10 items-center justify-center rounded-lg bg-accent-soft text-accent">
          <Compass class="size-5" aria-hidden="true" stroke-width={1.75} />
        </span>
        <h2 class="mt-6 text-xl font-semibold text-ink">Our vision</h2>
        <p class="mt-3 text-lg leading-relaxed text-slate-700">{site.vision}</p>
      </article>
    </div>
  </section>

  <section class="py-20 sm:py-24" aria-labelledby="competencies-title">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-20">
      <SectionHeading
        id="competencies-title"
        eyebrow="Core competencies"
        title="What we bring to a project"
        description="Six areas of work, from the first database schema to support long after launch."
      />
      <ul class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
        {
          services.map((s) => {
            const Icon = s.icon;
            return (
              <li class="flex gap-4">
                <Icon class="mt-0.5 size-5 shrink-0 text-accent" aria-hidden="true" stroke-width={1.75} />
                <div>
                  <h3 class="font-semibold text-ink">{s.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-muted">{s.description}</p>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-line bg-subtle py-20 sm:py-24" aria-labelledby="partners-title">
    <div class="container-page">
      <SectionHeading
        id="partners-title"
        eyebrow="Who we build for"
        title="Offices and communities across the university"
        description="Our systems are designed around the people who use them every day."
      />
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          partners.map((p) => (
            <li>
              <a
                href={url(`/projects/${p.slug}`)}
                class="flex h-full flex-col rounded-xl border border-line bg-white p-5 transition-colors hover:border-slate-300"
              >
                <BuildingComplex class="size-5 text-slate-400" aria-hidden="true" stroke-width={1.75} />
                <span class="mt-4 text-sm font-semibold text-ink first-letter:uppercase">{p.name.replace(/^the /, '')}</span>
                <span class="mt-1 text-xs text-muted">{p.project}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CallToAction />
</BaseLayout>
