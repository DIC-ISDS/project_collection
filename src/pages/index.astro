---
import { url } from '../lib/url';
import { ArrowRight, Check } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import TechnologyBadge from '../components/TechnologyBadge.astro';
import CallToAction from '../components/CallToAction.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
import { projects, highlights, milestones } from '../data/projects';
import { services } from '../data/services';
import { technologies } from '../data/technologies';

const principles = [
  'Data entered once, at the source, and reused everywhere',
  'Official forms and reports generated, not retyped',
  'Access by role and office, with a full audit trail',
  'Rolled out in phases, with the offices that use them',
];
---

<BaseLayout>
  <Hero />

  <!-- Highlights: documented facts only -->
  <section aria-label="Highlights" class="border-b border-line bg-white">
    <dl class="container-page grid grid-cols-2 gap-x-6 gap-y-10 py-12 lg:grid-cols-4">
      {
        highlights.map((h) => (
          <div class="flex flex-col border-l-2 border-accent/70 pl-4 sm:pl-5">
            <dt class="mt-1 text-sm font-medium text-ink">{h.label}</dt>
            <dd class="order-first text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{h.value}</dd>
            <dd class="mt-1 text-sm leading-snug text-muted">{h.detail}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- About -->
  <section class="py-20 sm:py-28" aria-labelledby="about-title">
    <div class="container-page grid gap-12 lg:grid-cols-2 lg:gap-20">
      <SectionHeading
        id="about-title"
        eyebrow="Who we are"
        title="A development team within the university"
        description={site.about[1]}
      >
        <div class="mt-8">
          <Button href={url('/about')} variant="secondary">
            More about ISDS
            <ArrowRight class="size-4" aria-hidden="true" />
          </Button>
        </div>
      </SectionHeading>
      <div class="rounded-2xl border border-line bg-subtle p-6 sm:p-8">
        <p class="text-sm font-semibold text-ink">How our systems work</p>
        <ul class="mt-5 space-y-4">
          {
            principles.map((p) => (
              <li class="flex gap-3">
                <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-accent text-white">
                  <Check class="size-3" stroke-width={3} aria-hidden="true" />
                </span>
                <span class="text-[15px] leading-relaxed text-slate-700">{p}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Featured projects -->
  <section class="border-y border-line bg-subtle py-20 sm:py-28" aria-labelledby="projects-title">
    <div class="container-page">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading
          id="projects-title"
          eyebrow="Featured projects"
          title="Systems built for real university work"
          description="Each project replaces a paper or spreadsheet process with one shared record that the whole office can rely on."
        />
        <Button href={url('/projects')} variant="secondary" class="self-start sm:self-auto">All projects</Button>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {projects.map((p, i) => <ProjectCard project={p} wide={projects.length % 2 === 1 && i === projects.length - 1} />)}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-20 sm:py-28" aria-labelledby="services-title">
    <div class="container-page">
      <SectionHeading
        id="services-title"
        eyebrow="What we do"
        title="From database design to day-to-day support"
        description="We design and build systems, and we keep them running and improving after launch."
      />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => <FeatureCard icon={s.icon} title={s.title} description={s.description} />)}
      </div>
    </div>
  </section>

  <!-- Achievements -->
  <section class="grid-backdrop-dark bg-navy py-20 text-white sm:py-28" aria-labelledby="milestones-title">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="text-[13px] font-semibold tracking-[0.04em] text-blue-300 uppercase">Milestones</p>
        <h2 id="milestones-title" class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-[2.25rem]">
          Where our work stands today
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-300">
          Each system is introduced in stages, starting with the parts that help offices right away.
        </p>
      </div>
      <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          milestones.map((m) => {
            const Icon = m.icon;
            return (
              <li class="rounded-xl bg-white/[0.04] p-6 ring-1 ring-white/10">
                <div class="flex items-center gap-3">
                  <span class="inline-flex size-9 items-center justify-center rounded-lg bg-blue-500/15 text-blue-200 ring-1 ring-blue-400/20">
                    <Icon class="size-[18px]" stroke-width={1.75} aria-hidden="true" />
                  </span>
                  <span class="text-xs font-semibold tracking-wide text-slate-400 uppercase">{m.project}</span>
                </div>
                <h3 class="mt-5 text-base font-semibold">{m.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-300">{m.description}</p>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <!-- Technologies -->
  <section class="py-20 sm:py-28" aria-labelledby="tech-title">
    <div class="container-page">
      <SectionHeading
        id="tech-title"
        eyebrow="Technologies"
        title="Proven tools, chosen for maintainability"
        description="The frameworks, data services and integrations used across our projects."
      />
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {
          technologies.map((group) => (
            <div class="rounded-xl border border-line bg-subtle p-6">
              <h3 class="text-base font-semibold text-ink">{group.title}</h3>
              <p class="mt-1 text-sm text-muted">{group.description}</p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {group.items.map((t) => <TechnologyBadge name={t.name} />)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CallToAction />
</BaseLayout>
