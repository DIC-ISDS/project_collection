---
import { url } from '../../lib/url';
import type { GetStaticPaths } from 'astro';
import { ArrowLeft, ArrowRight, Check, ChevronRight, Info, ShieldCheck, Gauge, Mail } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import TechnologyBadge from '../../components/TechnologyBadge.astro';
import Button from '../../components/Button.astro';
import CallToAction from '../../components/CallToAction.astro';
import { projects, type Project } from '../../data/projects';
import { mailto } from '../../data/site';

export const getStaticPaths = (() =>
  projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const techGroups = [project.stack, project.integrations].filter((g): g is NonNullable<typeof g> => Boolean(g));
---

<BaseLayout title={`${project.name} (${project.acronym})`} description={project.summary} type="article">
  <!-- Overview header -->
  <section class="border-b border-line bg-subtle">
    <div class="container-page py-12 sm:py-16">
      <nav aria-label="Breadcrumb">
        <ol class="flex items-center gap-1.5 text-sm text-muted">
          <li><a href={url('/projects')} class="hover:text-ink">Projects</a></li>
          <li aria-hidden="true"><ChevronRight class="size-3.5" /></li>
          <li aria-current="page" class="truncate text-ink">{project.shortName}</li>
        </ol>
      </nav>

      <div class="mt-8 grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <StatusBadge tone={project.status.tone} label={project.status.label} />
            <span class="text-sm font-medium text-muted">{project.domain}</span>
          </div>
          <h1 class="mt-5 text-4xl leading-[1.1] font-semibold tracking-tight text-balance text-ink sm:text-5xl">
            {project.name}
          </h1>
          <p class="mt-5 text-xl leading-relaxed text-pretty text-slate-700">{project.tagline}</p>
          <p class="mt-4 text-sm text-muted">Built for {project.partner}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <Button href={mailto(`Inquiry about ${project.shortName}`)}>
              <Mail class="size-4" aria-hidden="true" />
              Ask about this project
            </Button>
            <Button href={url('/projects')} variant="secondary">
              <ArrowLeft class="size-4" aria-hidden="true" />
              All projects
            </Button>
          </div>
        </div>
        <ProjectVisual project={project} size="hero" />
      </div>
    </div>
  </section>

  <!-- 1. Overview and intended users -->
  <section class="py-20 sm:py-24" aria-labelledby="overview-title">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
      <div>
        <p class="eyebrow">Overview</p>
        <h2 id="overview-title" class="mt-3 text-3xl font-semibold tracking-tight text-ink">What it is</h2>
        <div class="mt-6 space-y-4 text-lg leading-relaxed text-slate-700">
          {project.overview.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div>
        <h3 class="text-sm font-semibold tracking-wide text-muted uppercase">Who uses it</h3>
        <ul class="mt-5 grid gap-4 sm:grid-cols-2">
          {
            project.audience.map((a) => (
              <li class="rounded-xl border border-line bg-white p-5">
                <p class="font-semibold text-ink">{a.title}</p>
                <p class="mt-2 text-sm leading-relaxed text-muted">{a.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 2. Challenge -->
  <section class="border-y border-line bg-subtle py-20 sm:py-24" aria-labelledby="challenge-title">
    <div class="container-page">
      <SectionHeading id="challenge-title" eyebrow="The challenge" title="What had to change" description={project.challenge.intro} />
      {
        project.challenge.shifts?.length ? (
      <div class="mt-12 overflow-hidden rounded-xl border border-line bg-white">
        <div class="hidden grid-cols-[1fr_auto_1fr] gap-6 border-b border-line bg-subtle px-6 py-3 text-xs font-semibold tracking-wide text-muted uppercase md:grid">
          <span>Before</span><span class="w-5"></span><span>With {project.shortName}</span>
        </div>
        <ul class="divide-y divide-line">
          {
            project.challenge.shifts.map((s) => (
              <li class="grid gap-3 px-6 py-5 md:grid-cols-[1fr_auto_1fr] md:items-center md:gap-6">
                <p class="text-[15px] leading-relaxed text-muted">
                  <span class="mr-2 text-xs font-semibold tracking-wide text-slate-400 uppercase md:hidden">Before</span>
                  {s.before}
                </p>
                <ArrowRight class="hidden size-5 text-accent md:block" aria-hidden="true" />
                <p class="text-[15px] leading-relaxed font-medium text-ink">
                  <span class="mr-2 text-xs font-semibold tracking-wide text-accent uppercase md:hidden">Now</span>
                  {s.after}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
        ) : (
          <ul class="mt-12 grid gap-4 sm:grid-cols-2">
            {project.challenge.points?.map((point) => (
              <li class="flex gap-3 rounded-xl border border-line bg-white p-5">
                <Check class="mt-0.5 size-5 shrink-0 text-accent" aria-hidden="true" />
                <span class="text-[15px] leading-relaxed text-slate-700">{point}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <!-- 3. Solution and approach -->
  <section class="py-20 sm:py-24" aria-labelledby="approach-title">
    <div class="container-page">
      <SectionHeading id="approach-title" eyebrow="The approach" title={project.approach.title} description={project.approach.intro} />
      <ol class="mt-12 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {
          project.approach.steps.map((step, i) => (
            <li class="bg-white p-6">
              <span class="inline-flex size-7 items-center justify-center rounded-full bg-navy text-xs font-semibold text-white">
                {i + 1}
              </span>
              <h3 class="mt-4 font-semibold text-ink">{step.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 4. Key features and benefits -->
  <section class="border-y border-line bg-subtle py-20 sm:py-24" aria-labelledby="features-title">
    <div class="container-page">
      <SectionHeading id="features-title" eyebrow="Key features" title="What it does for the people who use it" />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {project.features.map((f) => <FeatureCard icon={f.icon} title={f.title} description={f.description} />)}
      </div>
    </div>
  </section>

  {
    (project.safeguards || techGroups.length > 0) && (
      <section class="py-20 sm:py-24" aria-label="Safeguards and technology">
        <div class="container-page grid gap-6 lg:grid-cols-2">
          {project.safeguards && (
            <div class="rounded-2xl border border-line p-8">
              <div class="flex items-center gap-3">
                <ShieldCheck class="size-5 text-accent" aria-hidden="true" stroke-width={1.75} />
                <h2 class="text-xl font-semibold text-ink">Security and accountability</h2>
              </div>
              <p class="mt-3 text-[15px] leading-relaxed text-muted">{project.safeguards.intro}</p>
              <ul class="mt-6 space-y-3">
                {project.safeguards.items.map((item) => (
                  <li class="flex gap-3 text-[15px] leading-relaxed text-slate-700">
                    <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {techGroups.length > 0 && (
            <div class="grid-backdrop-dark rounded-2xl bg-navy p-8 text-white">
              <h2 class="text-xl font-semibold">Technology</h2>
              {techGroups.map((g) => (
                <div class="mt-6">
                  <h3 class="text-xs font-semibold tracking-wide text-slate-400 uppercase">{g.label}</h3>
                  <ul class="mt-3 flex flex-wrap gap-2">
                    {g.items.map((t) => (
                      <TechnologyBadge name={t} dark />
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- Status and measurement -->
  <section class="border-t border-line bg-subtle py-20 sm:py-24" aria-labelledby="status-title">
    <div class:list={['container-page grid gap-12 lg:gap-16', project.measures && 'lg:grid-cols-[1.25fr_1fr]']}>
      <div>
        <p class="eyebrow">Where it stands</p>
        <h2 id="status-title" class="mt-3 text-3xl font-semibold tracking-tight text-ink">Status and rollout</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-muted">{project.progress.intro}</p>
        <ul class="mt-8 divide-y divide-line rounded-xl border border-line bg-white">
          {
            project.progress.items.map((item) => (
              <li class="flex flex-col gap-2 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
                <span class="text-[15px] text-slate-700">{item.label}</span>
                <span class="shrink-0">
                  <StatusBadge tone={item.tone} label={item.state} />
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      {
        project.measures && (
          <div>
            <div class="rounded-2xl border border-line bg-white p-8">
              <div class="flex items-center gap-3">
                <Gauge class="size-5 text-accent" aria-hidden="true" stroke-width={1.75} />
                <h2 class="text-xl font-semibold text-ink">How impact will be measured</h2>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-muted">{project.measures.intro}</p>
              <ul class="mt-6 space-y-3">
                {project.measures.items.map((m) => (
                  <li class="flex gap-3 text-[15px] leading-relaxed text-slate-700">
                    <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true" />
                    {m}
                  </li>
                ))}
              </ul>
            </div>
            {project.note && (
              <p class="mt-5 flex gap-3 rounded-xl border border-line bg-white p-5 text-sm leading-relaxed text-muted">
                <Info class="mt-0.5 size-4 shrink-0 text-slate-400" aria-hidden="true" />
                <span>{project.note}</span>
              </p>
            )}
          </div>
        )
      }
    </div>
  </section>

  <!-- Next project -->
  <section class="border-t border-line" aria-label="Next project">
    <div class="container-page py-10">
      <a
        href={url(`/projects/${next.slug}`)}
        class="group flex items-center justify-between gap-6 rounded-xl p-2 transition-colors"
      >
        <span>
          <span class="block text-sm text-muted">Next project</span>
          <span class="mt-1 block text-xl font-semibold tracking-tight text-ink group-hover:text-accent sm:text-2xl">
            {next.name}
          </span>
        </span>
        <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full border border-line text-ink transition-colors group-hover:border-accent group-hover:bg-accent group-hover:text-white">
          <ArrowRight class="size-5" aria-hidden="true" />
        </span>
      </a>
    </div>
  </section>

  <CallToAction
    title="Interested in a similar system?"
    description={`If your office faces challenges like the ones ${project.shortName} addresses, we’d be glad to talk through your process.`}
  />
</BaseLayout>
